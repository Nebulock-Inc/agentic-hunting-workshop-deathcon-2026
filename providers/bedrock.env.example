# AWS Bedrock — copy to .env and fill in your creds (or use a named profile).
# Install: pip install 'agentic-threat-hunting-framework[bedrock]'
# Requires Bedrock model access enabled in your AWS account/region.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1

# Or, instead of keys, use a configured profile:
# AWS_PROFILE=your-profile-name

# Optional: pin a Bedrock model ID.
ATHF_LLM_MODEL=us.anthropic.claude-sonnet-4-6
