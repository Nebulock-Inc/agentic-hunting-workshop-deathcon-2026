# Ollama (local, free) — copy to .env. No API key needed.
# Setup: install Ollama, then `ollama serve` and `ollama pull llama3`.
# ATHF auto-detects a running Ollama at localhost:11434.
ATHF_LLM_PROVIDER=ollama
ATHF_LLM_MODEL=llama3

# Optional: override if Ollama listens elsewhere.
# OLLAMA_BASE_URL=http://localhost:11434
