# OpenAI-compatible endpoint (self-hosted, vLLM, LiteLLM proxy, Together, Groq,
# Azure OpenAI, etc.) — copy to .env and fill in your endpoint + key.
# Install: pip install 'agentic-threat-hunting-framework[openai]'
ATHF_LLM_PROVIDER=openai
OPENAI_API_KEY=your-endpoint-key
OPENAI_BASE_URL=https://your-endpoint.example.com/v1

# Pin the model your endpoint serves.
ATHF_LLM_MODEL=your-model-name
